{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vipul-gupta-personal-website-local",
  "main": "workers/index.ts",
  "compatibility_date": "2026-10-04",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
  },
  "vars": { "LOCAL_OWNER_PREVIEW": "true" },
  "d1_databases": [
    {
      "binding": "SITE_DB",
      "database_name": "vipul-site-local",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "migrations",
      "remote": false,
    },
  ],
  // Local-only database identifier; never deploy with this configuration.
}
