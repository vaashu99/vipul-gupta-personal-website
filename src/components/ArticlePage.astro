---
import BaseLayout from '../layouts/BaseLayout.astro';
import ShareArticle from './ShareArticle.astro';
import ArticleReactions from './ArticleReactions.astro';

interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  categoryLabel: string;
  categoryHref: string;
  backHref: string;
  backLabel: string;
  moreLabel: string;
  coverImage?: string;
  coverAlt?: string;
}
const {
  title,
  description,
  publishedAt,
  categoryLabel,
  categoryHref,
  backHref,
  backLabel,
  moreLabel,
  coverImage,
  coverAlt,
} = Astro.props;
const date = new Intl.DateTimeFormat('en-SG', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'Asia/Singapore',
}).format(publishedAt);
const articleKey = Astro.url.pathname.replace(/^\/+|\/+$/g, '');
---

<BaseLayout
  title={`${title} | Vipul Gupta`}
  description={description}
  ogType="article"
  publishedTime={publishedAt.toISOString()}
>
  <article class="container article-container">
    <header class="page-header article-header">
      <a class="text-link article-back" href={backHref}>
        <span aria-hidden="true">←</span> {backLabel}
      </a>
      <div class="article-meta">
        <a class="tag" href={categoryHref}>
          {categoryLabel}
        </a>
        <time datetime={publishedAt.toISOString()}>{date}</time>
      </div>
      <h1 class="display">{title}</h1>
      <p class="lead">{description}</p>
      <p class="article-author">By Vipul Gupta</p>
    </header>
    {coverImage && (
      <figure class="article-cover">
        <img src={coverImage} alt={coverAlt} width="1200" height="800" />
      </figure>
    )}
    <div class="article-prose">
      <slot />
    </div>
    <ArticleReactions article={articleKey} />
    <ShareArticle title={title} description={description} />
    <div class="article-end">
      <a class="text-link" href={backHref}>
        {moreLabel} <span aria-hidden="true">→</span>
      </a>
    </div>
  </article>
</BaseLayout>

<style>
  .article-container {
    max-width: 850px;
    padding-bottom: clamp(4rem, 9vw, 7rem);
  }
  .article-header {
    padding-bottom: 2.5rem;
  }
  .article-header h1 {
    font-size: clamp(2.3rem, 6vw, 4.5rem);
    overflow-wrap: anywhere;
  }
  .article-back {
    display: inline-block;
    margin-bottom: 2.5rem;
  }
  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
    align-items: center;
    margin-bottom: 1.5rem;
    color: var(--color-muted);
    font-size: 0.85rem;
  }
  .article-author {
    font-size: 0.85rem;
    color: var(--color-muted);
    margin-top: 1rem;
  }
  .article-cover {
    margin: 0 0 3rem;
  }
  .article-cover img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 12px;
  }
  .article-prose {
    font-size: 1.05rem;
    line-height: 1.85;
    overflow-wrap: anywhere;
  }
  .article-prose :global(h2),
  .article-prose :global(h3),
  .article-prose :global(h4) {
    line-height: 1.3;
    margin-block: 2.5rem 1rem;
  }
  .article-prose :global(h2) {
    font-size: clamp(1.7rem, 4vw, 2.2rem);
  }
  .article-prose :global(h3) {
    font-size: 1.5rem;
  }
  .article-prose :global(p),
  .article-prose :global(ul),
  .article-prose :global(ol) {
    margin-block: 0 1.5rem;
  }
  .article-prose :global(li) {
    margin-block: 0.35rem;
  }
  .article-prose :global(ul),
  .article-prose :global(ol) {
    padding-left: 1.5rem;
  }
  .article-prose :global(img),
  .article-prose :global(video) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }
  .article-prose :global(figure) {
    margin-block: 2rem;
  }
  .article-prose :global(figure img) {
    display: block;
    width: 100%;
  }
  .article-prose :global(figcaption) {
    margin-top: 0.75rem;
    color: var(--color-muted);
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .article-prose :global(a) {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .article-prose :global(blockquote) {
    margin: 2rem 0;
    padding: 0.75rem 1.5rem;
    border-left: 3px solid var(--color-accent);
    background: var(--color-surface);
  }
  .article-prose :global(blockquote p:last-child) {
    margin-bottom: 0;
  }
  .article-prose :global(pre) {
    max-width: 100%;
    overflow-x: auto;
    padding: 1.25rem;
    border-radius: 8px;
    font-size: 0.85rem;
    line-height: 1.6;
  }
  .article-prose :global(code) {
    font-size: 0.85em;
  }
  .article-prose :global(:not(pre) > code) {
    padding: 0.15rem 0.35rem;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: var(--color-surface);
  }
  .article-prose :global(table) {
    display: block;
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    margin-block: 2rem;
    font-size: 0.9rem;
  }
  .article-prose :global(th),
  .article-prose :global(td) {
    text-align: left;
    padding: 0.65rem 1rem;
    border: 1px solid var(--color-border);
  }
  .article-prose :global(th) {
    background: var(--color-surface);
  }
  .article-prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--color-border);
    margin-block: 3rem;
  }
  .article-end {
    margin-top: 3rem;
    border-top: 1px solid var(--color-border);
    padding-top: 2rem;
  }
</style>
