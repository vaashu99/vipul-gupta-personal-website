---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found — Vipul Gupta"
  description="This page could not be found. Return to Vipul Gupta's homepage or explore the journal."
>
  <section class="container section page-header">
    <p class="eyebrow">404 / A little off the path</p>
    <h1>
      This page took
      <br />
      <em>a different turn.</em>
    </h1>
    <p class="lead">
      The address may have changed, or the page may not exist yet. There is
      plenty to explore from home.
    </p>
    <a class="button" href="/">
      Back to home <span aria-hidden="true">→</span>
    </a>
  </section>
</BaseLayout>
