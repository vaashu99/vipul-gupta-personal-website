---
import BaseLayout from '../layouts/BaseLayout.astro';

const socialProfiles = [
  {
    label: 'YouTube',
    handle: '@musicroadandlaugh',
    href: 'https://youtube.com/@musicroadandlaugh',
  },
  {
    label: 'X / Twitter',
    handle: '@vipulgupta_99',
    href: 'https://x.com/vipulgupta_99',
  },
  {
    label: 'Instagram',
    handle: '@vipulguptasg',
    href: 'https://www.instagram.com/vipulguptasg',
  },
  {
    label: 'Facebook',
    handle: 'vaashu.gupta',
    href: 'https://www.facebook.com/vaashu.gupta',
  },
];
---

<BaseLayout
  title="My Space | Vipul Gupta"
  description="Vipul Gupta's personal space for travel, photographs and memories. A home for experiences and little moments, growing one collection at a time."
>
  <section class="container page-header space-header">
    <p class="eyebrow">A life beyond work</p>
    <h1 class="display">A little more of life.</h1>
    <p class="lead">
      A corner for the places I explore, the photographs I keep, and the moments
      I'd like to remember. A personal space, slowly taking shape.
    </p>
    <nav class="space-navigation" aria-label="Explore My Space">
      <a href="#travel">
        Travel <span aria-hidden="true">↘</span>
      </a>
      <a href="#photos">
        Photos <span aria-hidden="true">↘</span>
      </a>
      <a href="#memories">
        Memories <span aria-hidden="true">↘</span>
      </a>
      <a href="#elsewhere">
        Elsewhere <span aria-hidden="true">↘</span>
      </a>
    </nav>
  </section>

  <section
    class="container space-section"
    id="travel"
    aria-labelledby="travel-heading"
  >
    <div class="space-section-grid">
      <div class="space-introduction">
        <p class="eyebrow">01 / Travel</p>
        <h2 id="travel-heading">
          Places worth
          <br />
          remembering.
        </h2>
        <p>
          A home for travel experiences, new perspectives, and the details that
          make a place memorable. I'll share those stories here when they're
          ready.
        </p>
      </div>
      <div class="space-note">
        <svg
          class="space-symbol"
          viewBox="0 0 72 72"
          fill="none"
          aria-hidden="true"
        >
          <circle
            cx="36"
            cy="36"
            r="27"
            stroke="currentColor"
            stroke-width="1.5"
          ></circle>
          <path
            d="m46 26-6 14-14 6 6-14 14-6Z"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linejoin="round"
          ></path>
          <circle cx="36" cy="36" r="2" fill="currentColor"></circle>
          <path
            d="M36 5v8M36 59v8M5 36h8M59 36h8"
            stroke="currentColor"
            stroke-width="1.5"
          ></path>
        </svg>
        <h3>The stories are still to come.</h3>
        <p>
          No travel stories published yet. This section will grow as I put those
          experiences into words.
        </p>
      </div>
    </div>
  </section>

  <section
    class="container space-section"
    id="photos"
    aria-labelledby="photos-heading"
  >
    <div class="space-section-grid">
      <div class="space-introduction">
        <p class="eyebrow">02 / Photos</p>
        <h2 id="photos-heading">
          A moment.
          <br />A different view.
        </h2>
        <p>
          Sometimes a photograph says more than a page of words. Selected public
          collections will have their own home in the gallery, with a little
          context behind the pictures.
        </p>
        <a class="text-link" href="/photos/">
          Visit the photo gallery <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="space-note">
        <svg
          class="space-symbol"
          viewBox="0 0 72 72"
          fill="none"
          aria-hidden="true"
        >
          <rect
            x="10"
            y="14"
            width="52"
            height="42"
            rx="4"
            stroke="currentColor"
            stroke-width="1.5"
          ></rect>
          <circle
            cx="44"
            cy="27"
            r="5"
            stroke="currentColor"
            stroke-width="1.5"
          ></circle>
          <path
            d="m12 49 14-15 11 11 9-8 14 12M18 62h36"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
        <h3>A gallery in the making.</h3>
        <p>
          No photo collections published yet. The gallery is ready for the
          photographs I choose to share.
        </p>
      </div>
    </div>
  </section>

  <section
    class="container space-section"
    id="memories"
    aria-labelledby="memories-heading"
  >
    <div class="space-section-grid">
      <div class="space-introduction">
        <p class="eyebrow">03 / Memories</p>
        <h2 id="memories-heading">
          The small things
          <br />
          that stay.
        </h2>
        <p>
          A place for moments with personal meaning: the little details, people,
          and occasions I'd like to remember. A space to return to, rather than
          let everything slip past.
        </p>
      </div>
      <div class="space-note">
        <svg
          class="space-symbol"
          viewBox="0 0 72 72"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M18 12h33a5 5 0 0 1 5 5v44H22a6 6 0 0 1-6-6V18a6 6 0 0 1 6-6Z"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linejoin="round"
          ></path>
          <path
            d="M22 12v43M17 55h39M30 23h18M30 30h12"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
          ></path>
          <path
            d="m41 38 2 4 4 .5-3 3 .7 4.5-3.7-2-3.7 2 .7-4.5-3-3 4-.5 2-4Z"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linejoin="round"
          ></path>
        </svg>
        <h3>A few pages waiting to be filled.</h3>
        <p>
          No memories published yet. When there's something ready to share, it
          will appear here.
        </p>
      </div>
    </div>
  </section>

  <section
    class="container space-section"
    id="elsewhere"
    aria-labelledby="elsewhere-heading"
  >
    <div class="space-introduction">
      <p class="eyebrow">04 / Elsewhere, online</p>
      <h2 id="elsewhere-heading">A few more ways to find me.</h2>
      <p>My personal profiles, collected in one place.</p>
    </div>
    <ul class="social-grid">
      {socialProfiles.map((social) => (
        <li>
          <a href={social.href} target="_blank" rel="noopener noreferrer">
            <span class="social-heading">
              <strong>{social.label}</strong>
              <span aria-hidden="true">↗</span>
            </span>
            <span class="social-handle">{social.handle}</span>
            <span class="social-destination">
              Visit profile{' '}
              <span class="sr-only">
                on {social.label} (opens in a new tab)
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <aside
    class="container space-journal"
    aria-labelledby="space-journal-heading"
  >
    <div>
      <p class="eyebrow">For thoughts along the way</p>
      <h2 id="space-journal-heading">There's a journal, too.</h2>
      <p>
        Thoughts, life notes, what-if ideas, and a little humour have their own
        space.
      </p>
    </div>
    <a class="text-link" href="/journal/">
      Explore the journal <span aria-hidden="true">→</span>
    </a>
  </aside>
</BaseLayout>

<style>
  .space-header .lead {
    max-width: 43rem;
  }

  .space-navigation {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    margin-top: 34px;
  }

  .space-navigation a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 16px;
    font-size: 0.88rem;
  }

  .space-section {
    padding-block: clamp(48px, 7vw, 80px);
    border-bottom: 1px solid var(--color-border);
    scroll-margin-top: 24px;
  }

  .space-section-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(32px, 7vw, 90px);
  }

  .space-introduction h2 {
    margin-bottom: 24px;
  }

  .space-introduction > p:not(.eyebrow) {
    max-width: 31rem;
    color: var(--color-muted);
  }

  .space-introduction .text-link {
    margin-top: 24px;
  }

  .space-note {
    padding: clamp(28px, 4vw, 44px);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-surface);
  }

  .space-symbol {
    width: 64px;
    height: 64px;
    margin-bottom: 27px;
    color: var(--color-accent);
  }

  .space-note h3 {
    margin-bottom: 14px;
    font-size: 1.08rem;
    line-height: 1.4;
  }

  .space-note p {
    max-width: 29rem;
    color: var(--color-muted);
    font-size: 0.93rem;
  }

  .social-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
  }

  .social-grid a {
    display: flex;
    height: 100%;
    flex-direction: column;
    gap: 12px;
    padding: 24px;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-surface);
    text-decoration: none;
  }

  .social-grid a:hover {
    border-color: var(--color-accent);
  }

  .social-heading {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }

  .social-heading strong {
    color: var(--color-ink);
    font-size: 0.95rem;
    font-weight: 600;
  }

  .social-handle {
    color: var(--color-muted);
    font-size: 0.8rem;
    overflow-wrap: anywhere;
  }

  .social-destination {
    margin-top: 10px;
    font-size: 0.8rem;
    text-decoration: underline;
    text-underline-offset: 0.24em;
  }

  .space-journal {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    padding-block: 64px 35px;
  }

  .space-journal h2 {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
  }

  .space-journal p:not(.eyebrow) {
    max-width: 35rem;
    margin-top: 16px;
    color: var(--color-muted);
  }

  @media (max-width: 1000px) {
    .social-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 480px) {
    .social-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 760px) {
    .space-section-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .space-journal {
      align-items: start;
      flex-direction: column;
      padding-top: 48px;
    }
  }
</style>
