---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
---

<BaseLayout
  title="Chat — Vipul Gupta"
  description="Leave Vipul a private message and return to this browser to read his reply."
>
  <div class="container chat-page">
    <header class="page-header">
      <p class="eyebrow">Say hello</p>
      <h1 class="display">Let’s start a conversation.</h1>
      <p class="lead">Leave a message. I’ll reply here when available.</p>
    </header>
    <section class="chat-panel" aria-labelledby="conversation-heading">
      <div class="chat-toolbar">
        <h2 id="conversation-heading">Your conversation</h2>
        <button
          class="button button--outline"
          type="button"
          id="refresh-chat"
          hidden
        >
          Refresh replies
        </button>
      </div>
      <p class="chat-note">
        This conversation stays connected to this browser using a cookie. Return
        here to read replies; clearing cookies or switching browsers starts a
        new conversation. Please don’t send passwords or sensitive personal
        information.
      </p>
      <p id="chat-empty" class="chat-empty">
        Send a message about work, an article, or something you’d like to
        discuss.
      </p>
      <ol
        id="chat-messages"
        class="chat-messages"
        aria-label="Conversation messages"
      ></ol>
      <p
        id="chat-status"
        class="chat-status"
        role="status"
        aria-live="polite"
      ></p>
      <form id="chat-form" hidden>
        <fieldset class="sender-details" aria-describedby="sender-help">
          <legend>A little about you</legend>
          <p id="sender-help" class="chat-note">
            Please share your name and either an email address or a phone
            number. These details are visible only to Vipul and are
            self-reported, not verified. Adding contact details does not send
            automatic email or SMS; replies still appear here.
          </p>
          <div class="sender-fields">
            <div>
              <label for="sender-name">Your name</label>
              <input
                id="sender-name"
                name="senderName"
                type="text"
                autocomplete="name"
                maxlength="100"
                required
                aria-describedby="sender-help"
              />
            </div>
            <div>
              <label for="sender-contact-type">Contact method</label>
              <select id="sender-contact-type" name="contactType">
                <option value="email">Email</option>
                <option value="phone">Phone</option>
              </select>
            </div>
            <div class="contact-field">
              <label id="sender-contact-label" for="sender-contact">
                Email address
              </label>
              <input
                id="sender-contact"
                name="contactValue"
                type="email"
                inputmode="email"
                autocomplete="email"
                maxlength="254"
                required
                aria-describedby="contact-help"
              />
              <p id="contact-help" class="chat-note">
                Use an address such as name@example.com.
              </p>
            </div>
          </div>
          <p class="chat-note sender-edit-note">
            Already chatting? Your saved details appear here. You can edit them
            before sending your next message.
          </p>
        </fieldset>
        <label for="chat-message">Your message</label>
        <textarea
          id="chat-message"
          name="message"
          rows="4"
          maxlength="2000"
          required
          placeholder="Hi Vipul…"
        ></textarea>
        <div class="composer-actions">
          <span class="chat-note">Up to 2,000 characters.</span>
          <button class="button" type="submit" id="send-chat">
            Send message
          </button>
        </div>
      </form>
      <noscript>
        <p class="chat-note">
          Enable JavaScript to use the website chat, or{' '}
          <a href={profile.linkedin} rel="me">
            reach out on LinkedIn
          </a>
          .
        </p>
      </noscript>
    </section>
    <p class="chat-alternative">
      Prefer another way to connect?{' '}
      <a href={profile.linkedin} rel="me">
        Find me on LinkedIn
      </a>
      .
    </p>
  </div>
</BaseLayout>

<script>
  type Message = {
    id: number;
    sender: 'visitor' | 'owner';
    content: string;
    createdAt: string;
  };
  type Sender = {
    name: string;
    contactType: 'email' | 'phone';
    contactValue: string;
  };
  type Conversation = {
    threadId: string | null;
    messages: Message[];
    sender: Sender | null;
  };
  const form = document.querySelector<HTMLFormElement>('#chat-form');
  const input = document.querySelector<HTMLTextAreaElement>('#chat-message');
  const send = document.querySelector<HTMLButtonElement>('#send-chat');
  const refresh = document.querySelector<HTMLButtonElement>('#refresh-chat');
  const transcript = document.querySelector<HTMLOListElement>('#chat-messages');
  const empty = document.querySelector<HTMLElement>('#chat-empty');
  const status = document.querySelector<HTMLElement>('#chat-status');
  const senderName = document.querySelector<HTMLInputElement>('#sender-name');
  const contactType = document.querySelector<HTMLSelectElement>(
    '#sender-contact-type',
  );
  const contact = document.querySelector<HTMLInputElement>('#sender-contact');
  const contactLabel = document.querySelector<HTMLElement>(
    '#sender-contact-label',
  );
  const contactHelp = document.querySelector<HTMLElement>('#contact-help');

  if (
    form &&
    input &&
    send &&
    refresh &&
    transcript &&
    empty &&
    status &&
    senderName &&
    contactType &&
    contact &&
    contactLabel &&
    contactHelp
  ) {
    form.hidden = false;
    refresh.hidden = false;
    let senderEdited = false;
    let savedSenderSignature = '';
    let previousContactType: 'email' | 'phone' = 'email';
    const contactDrafts = { email: '', phone: '' };
    const emailPattern = /^[^\s@<>]+@[^\s@<>]+\.[^\s@<>]+$/;
    const phonePattern = /^[+]?\d[\d\s().-]*$/;
    let busy = false;
    let hasConversation = false;
    let lastSeenId = 0;
    let initialLoad = true;
    let poll: ReturnType<typeof setInterval> | undefined;

    function configureContact() {
      const phone = contactType!.value === 'phone';
      contact!.type = phone ? 'tel' : 'email';
      contact!.inputMode = phone ? 'tel' : 'email';
      contact!.autocomplete = phone ? 'tel' : 'email';
      contact!.maxLength = phone ? 50 : 254;
      contactLabel!.textContent = phone ? 'Phone number' : 'Email address';
      contactHelp!.textContent = phone
        ? 'Include your country code, for example +65 8123 4567.'
        : 'Use an address such as name@example.com.';
      contact!.setCustomValidity('');
      contact!.removeAttribute('aria-invalid');
    }

    function invalid(
      field: HTMLInputElement | HTMLTextAreaElement,
      message: string,
    ) {
      field.setCustomValidity(message);
      field.setAttribute('aria-invalid', 'true');
      status!.textContent = message;
      field.reportValidity();
      field.focus();
    }

    function senderDetails(): Sender | null {
      const name = senderName!.value.trim();
      const value = contact!.value.trim();
      const kind = contactType!.value === 'phone' ? 'phone' : 'email';
      if (
        !name ||
        name.length > 100 ||
        /[\u0000-\u001f\u007f-\u009f\u202a-\u202e\u2066-\u2069]/.test(name)
      ) {
        invalid(senderName!, 'Enter your name, using up to 100 characters.');
        return null;
      }
      if (
        kind === 'email' &&
        (value.length > 254 || !emailPattern.test(value))
      ) {
        invalid(
          contact!,
          'Enter a valid email address, such as name@example.com.',
        );
        return null;
      }
      const digits = value.replace(/\D/g, '').length;
      if (
        kind === 'phone' &&
        (value.length > 50 ||
          !phonePattern.test(value) ||
          digits < 7 ||
          digits > 20)
      ) {
        invalid(
          contact!,
          'Enter a phone number with 7–20 digits, including your country code.',
        );
        return null;
      }
      return { name, contactType: kind, contactValue: value };
    }

    for (const field of [senderName, contact, input]) {
      field.addEventListener('input', () => {
        field.setCustomValidity('');
        field.removeAttribute('aria-invalid');
        if (field !== input) senderEdited = true;
      });
    }
    contactType.addEventListener('change', () => {
      contactDrafts[previousContactType] = contact.value;
      previousContactType = contactType.value === 'phone' ? 'phone' : 'email';
      contact.value = contactDrafts[previousContactType];
      senderEdited = true;
      configureContact();
    });
    form.addEventListener(
      'invalid',
      (event) => {
        const field = event.target;
        if (
          field instanceof HTMLInputElement ||
          field instanceof HTMLTextAreaElement
        ) {
          field.setAttribute('aria-invalid', 'true');
          status.textContent = field.validationMessage;
        }
      },
      true,
    );

    function updatePolling() {
      if (poll !== undefined) clearInterval(poll);
      poll = undefined;
      if (hasConversation && !document.hidden && document.hasFocus()) {
        poll = setInterval(() => {
          if (!busy) void load(true);
        }, 15000);
      }
    }

    function render(conversation: Conversation) {
      const senderSignature = JSON.stringify(conversation.sender);
      if (
        conversation.sender &&
        !senderEdited &&
        senderSignature !== savedSenderSignature
      ) {
        savedSenderSignature = senderSignature;
        senderName!.value = conversation.sender.name;
        contactType!.value = conversation.sender.contactType;
        previousContactType = conversation.sender.contactType;
        contact!.value = conversation.sender.contactValue;
        contactDrafts[previousContactType] = conversation.sender.contactValue;
        configureContact();
      }
      const hadMessages = lastSeenId > 0;
      let newReply = false;
      const fragment = document.createDocumentFragment();
      for (const message of conversation.messages) {
        const item = document.createElement('li');
        item.className = `message message--${message.sender}`;
        const author = document.createElement('strong');
        author.textContent = message.sender === 'owner' ? 'Vipul' : 'You';
        const content = document.createElement('p');
        content.textContent = message.content;
        const time = document.createElement('time');
        time.dateTime = message.createdAt;
        const date = new Date(message.createdAt);
        time.textContent = Number.isNaN(date.getTime())
          ? ''
          : date.toLocaleString(undefined, {
              dateStyle: 'medium',
              timeStyle: 'short',
            });
        item.append(author, content, time);
        fragment.append(item);
        if (message.id > lastSeenId && message.sender === 'owner')
          newReply = true;
      }
      transcript!.replaceChildren(fragment);
      empty!.hidden = conversation.messages.length > 0;
      hasConversation = conversation.threadId !== null;
      lastSeenId = Math.max(
        lastSeenId,
        ...conversation.messages.map((message) => message.id),
      );
      if (newReply && hadMessages)
        status!.textContent =
          'Vipul replied. Your conversation has been updated.';
      updatePolling();
    }

    async function request(options?: RequestInit): Promise<Conversation> {
      const response = await fetch('/api/chat', {
        credentials: 'same-origin',
        cache: 'no-store',
        ...options,
      });
      const data = await response.json().catch(() => null);
      if (!response.ok)
        throw new Error(
          data?.message || 'Chat is unavailable right now. Please try again.',
        );
      if (!data || !Array.isArray(data.messages))
        throw new Error('Chat is unavailable right now. Please try again.');
      return data as Conversation;
    }

    async function load(quiet = false) {
      if (busy) return;
      busy = true;
      refresh!.disabled = true;
      send!.disabled = true;
      if (!quiet) status!.textContent = 'Checking for messages…';
      try {
        const conversation = await request();
        if (!quiet)
          status!.textContent = conversation.messages.length
            ? 'Your conversation is up to date.'
            : 'Ready when you are.';
        render(conversation);
        initialLoad = false;
      } catch (error) {
        if (!quiet || initialLoad)
          status!.textContent =
            error instanceof Error
              ? error.message
              : 'Could not check messages. Please try again.';
        else
          status!.textContent =
            'Could not refresh replies. Use Refresh replies to try again.';
      } finally {
        busy = false;
        refresh!.disabled = false;
        send!.disabled = false;
      }
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const message = input.value.trim();
      if (busy) return;
      if (!message) {
        invalid(input, 'Enter a message before sending.');
        return;
      }
      const sender = senderDetails();
      if (!sender) return;
      busy = true;
      send.disabled = true;
      refresh.disabled = true;
      input.readOnly = true;
      senderName.readOnly = true;
      contact.readOnly = true;
      contactType.disabled = true;
      status.textContent = 'Sending your message…';
      try {
        const conversation = await request({
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message, sender }),
        });
        senderEdited = false;
        render(conversation);
        input.value = '';
        status.textContent =
          'Message saved. Come back to this browser to read my reply.';
      } catch (error) {
        status.textContent =
          error instanceof Error
            ? error.message
            : 'Your message could not be sent. Please try again.';
      } finally {
        busy = false;
        send.disabled = false;
        refresh.disabled = false;
        input.readOnly = false;
        senderName.readOnly = false;
        contact.readOnly = false;
        contactType.disabled = false;
      }
    });
    refresh.addEventListener('click', () => {
      void load();
    });
    document.addEventListener('visibilitychange', updatePolling);
    window.addEventListener('focus', () => {
      updatePolling();
      if (hasConversation && !busy) void load(true);
    });
    window.addEventListener('blur', updatePolling);
    window.addEventListener('pagehide', () => {
      if (poll !== undefined) clearInterval(poll);
    });
    void load();
  }
</script>

<style>
  .chat-page {
    max-width: 900px;
    padding-bottom: 5rem;
  }
  .chat-panel {
    padding: clamp(1.2rem, 4vw, 2rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }
  .chat-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .chat-toolbar h2 {
    font-size: 1.7rem;
  }
  .chat-toolbar button {
    font-size: 0.85rem;
    padding: 0.5rem 0.8rem;
  }
  .chat-note {
    color: var(--color-muted);
    font-size: 0.9rem;
  }
  .chat-panel > .chat-note {
    margin-top: 1rem;
  }
  .chat-empty {
    padding: 2rem 0 1rem;
    color: var(--color-muted);
  }
  .chat-messages {
    padding: 0;
    margin: 1.5rem 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .chat-messages :global(.message) {
    width: min(90%, 600px);
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
    overflow-wrap: anywhere;
  }
  .chat-messages :global(.message--visitor) {
    align-self: flex-end;
    background: var(--color-sage);
  }
  .chat-messages :global(.message strong) {
    font-size: 0.85rem;
  }
  .chat-messages :global(.message p) {
    white-space: pre-wrap;
    margin-top: 0.3rem;
  }
  .chat-messages :global(.message time) {
    display: block;
    color: var(--color-muted);
    font-size: 0.75rem;
    margin-top: 0.5rem;
  }
  .chat-status {
    min-height: 1.8rem;
    margin: 1rem 0;
    color: var(--color-muted);
  }
  form label {
    display: block;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
  textarea,
  input,
  select {
    width: 100%;
    padding: 0.85rem;
    color: var(--color-ink);
    background: var(--color-bg);
    border: 1px solid var(--color-outline);
    border-radius: var(--radius);
  }
  textarea {
    resize: vertical;
  }
  .sender-details {
    margin: 0 0 1.5rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    min-width: 0;
  }
  .sender-details legend {
    padding: 0 0.4rem;
    font-weight: 600;
  }
  .sender-fields {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 1rem;
    margin-top: 1rem;
  }
  .contact-field {
    grid-column: 1 / -1;
  }
  .sender-edit-note {
    margin-top: 1rem;
  }
  #contact-help {
    margin-top: 0.4rem;
  }
  @media (max-width: 500px) {
    .sender-fields {
      grid-template-columns: 1fr;
    }
  }
  .composer-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.8rem;
    flex-wrap: wrap;
  }
  .chat-alternative {
    margin-top: 1.5rem;
    color: var(--color-muted);
  }
  [hidden] {
    display: none !important;
  }
</style>
