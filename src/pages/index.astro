---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile, highlights } from '../data/profile';

const recentPosts = (
  await getCollection(
    'tech',
    ({ data }) => !data.draft && data.publishedAt.getTime() <= Date.now(),
  )
)
  .sort(
    (a, b) =>
      b.data.publishedAt.getTime() - a.data.publishedAt.getTime() ||
      a.id.localeCompare(b.id),
  )
  .slice(0, 3);
const techPath = (id: string) =>
  `/tech/${id.split('/').map(encodeURIComponent).join('/')}/`;
const postDate = (date: Date) =>
  new Intl.DateTimeFormat('en-SG', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'Asia/Singapore',
  }).format(date);
const postCategories = {
  engineering: 'Engineering',
  community: 'Community',
  learning: 'Learning',
};
---

<BaseLayout
  title="Vipul Gupta — Systems, stories & everything between"
  description={`Meet Vipul Gupta, a ${profile.role} in Singapore. Explore a career in cloud infrastructure, alongside a growing space for travel, photography, and personal writing.`}
>
  <section class="container hero-grid" aria-labelledby="home-title">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="status-dot" aria-hidden="true"></span> Vipul Gupta ·
        Singapore
      </p>
      <h1 id="home-title" class="hero-title">
        Reliable systems.
        <br />
        <em>Curious mind.</em>
      </h1>
      <p class="lead">
        I build resilient cloud infrastructure. This is also my space for the
        places I explore, the photographs I take, and the things I learn.
      </p>
      <div class="hero-actions">
        <a class="button" href="/experience/">
          Explore my experience <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="/about/">
          A little about me <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="hero-caption">
        <span class="mini-rule" aria-hidden="true"></span> A professional life.
        A personal perspective.
      </div>
    </div>
    <aside class="hero-aside" aria-label="Portrait of Vipul">
      <div class="portrait-mat">
        <span class="portrait-label">A face behind the systems</span>
        <a
          class="portrait-link"
          href="/images/portrait-enhanced-full.webp"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="View a larger photo of Vipul Gupta in a new tab"
        >
          <img
            class="hero-portrait"
            src="/images/portrait-enhanced-1200.webp"
            srcset="/images/portrait-enhanced-600.webp 600w, /images/portrait-enhanced-1200.webp 1200w, /images/portrait-enhanced-2400.webp 2400w"
            sizes="(max-width: 392px) calc(100vw - 91.6px), (max-width: 800px) 300.4px, (max-width: 1077px) calc(40vw - 82.24px), 348.4px"
            alt="Vipul Gupta standing in front of an aquarium."
            width="1200"
            height="872"
            fetchpriority="high"
          />
        </a>
        <div class="portrait-footer">
          <span>
            Engineer.
            <br />
            Always learning.
          </span>
          <span class="portrait-mark" aria-hidden="true">
            VG.
          </span>
        </div>
      </div>
      <a
        class="portrait-zoom text-link"
        href="/images/portrait-enhanced-full.webp"
        target="_blank"
        rel="noopener noreferrer"
      >
        View full-size photo <span aria-hidden="true">↗</span>
      </a>
      <div class="hero-note">
        <span aria-hidden="true">✳</span>
        <span>
          Based in Singapore.
          <br />
          Interested in what's beyond the everyday.
        </span>
      </div>
    </aside>
  </section>

  <section class="container stats-strip" aria-label="Professional snapshot">
    <div class="stat">
      <strong>10+ years</strong>
      <span>Across operations, DevOps & SRE</span>
    </div>
    <div class="stat">
      <strong>GXS Bank</strong>
      <span>
        {profile.role} · since {profile.roleSince}
      </span>
    </div>
    <div class="stat">
      <strong>Cloud to code</strong>
      <span>AWS · Kubernetes · GitOps</span>
    </div>
  </section>

  <section class="container section" aria-labelledby="work-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / The professional side</p>
        <h2 id="work-heading">
          Making complex systems
          <br />
          <em>work simply.</em>
        </h2>
      </div>
      <a class="text-link" href="/experience/">
        The full career story <span aria-hidden="true">↗</span>
      </a>
    </div>
    <p class="section-intro">{profile.summary}</p>
    <div class="focus-grid">
      {highlights.map((item, index) => (
        <article class="focus-card">
          <span class="focus-number" aria-hidden="true">
            0{index + 1}
          </span>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="recent-posts section" aria-labelledby="recent-posts-heading">
    <div class="container">
      <div class="section-heading recent-posts-heading">
        <div>
          <p class="eyebrow">02 / Recently, in my world</p>
          <h2 id="recent-posts-heading">
            Conversations, learning
            <br />
            &amp; new milestones.
          </h2>
        </div>
        <a class="text-link recent-posts-link" href="/tech/">
          Explore Tech <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="recent-posts-grid">
        {recentPosts.map((entry) => (
          <article class="card recent-post-card">
            <div class="recent-post-meta">
              <span class="tag">{postCategories[entry.data.category]}</span>
              <time datetime={entry.data.publishedAt.toISOString()}>
                {postDate(entry.data.publishedAt)}
              </time>
            </div>
            <h3>
              <a href={techPath(entry.id)}>{entry.data.title}</a>
            </h3>
            <p>{entry.data.description}</p>
            <a class="text-link" href={techPath(entry.id)}>
              Read the post <span aria-hidden="true">→</span>
              <span class="visually-hidden">: {entry.data.title}</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="personal-section" aria-labelledby="personal-heading">
    <div class="container personal-grid">
      <div>
        <p class="eyebrow">03 / Beyond the terminal</p>
        <h2 id="personal-heading">
          A little room
          <br />
          for <em>everything else.</em>
        </h2>
        <p class="lead">
          Travel, photographs, and memories worth keeping. My Space brings
          together the places I explore and the moments I want to share.
        </p>
        <a class="button button--outline" href="/my-space/">
          Explore My Space <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="personal-list">
        <a href="/my-space/#travel">
          <span class="personal-icon" aria-hidden="true">
            ↗
          </span>
          <div>
            <h3>Travel</h3>
            <p>Travel experiences and the details worth remembering.</p>
          </div>
          <span aria-hidden="true">→</span>
        </a>
        <a href="/my-space/#photos">
          <span class="personal-icon" aria-hidden="true">
            ◎
          </span>
          <div>
            <h3>Photos</h3>
            <p>Photo collections, one moment at a time.</p>
          </div>
          <span aria-hidden="true">→</span>
        </a>
        <a href="/my-space/#memories">
          <span class="personal-icon" aria-hidden="true">
            ✎
          </span>
          <div>
            <h3>Memories</h3>
            <p>
              Little moments, meaningful milestones, and things worth
              remembering.
            </p>
          </div>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section
    class="container section journal-invitation"
    aria-labelledby="journal-heading"
  >
    <div>
      <p class="eyebrow">04 / A new chapter</p>
      <h2 id="journal-heading">Room for a wandering mind.</h2>
      <p>
        Thoughts &amp; Conversations, Life Notes, What If, and Humour. The
        journal has room for questions, reflections, imagined possibilities, and
        a little laughter. The first entries are still to come.
      </p>
    </div>
    <a class="text-link" href="/journal/">
      Explore the journal <span aria-hidden="true">↗</span>
    </a>
  </section>
  <section class="container contact-banner" aria-labelledby="contact-heading">
    <div>
      <p class="eyebrow">Keep in touch</p>
      <h2 id="contact-heading">
        Good conversations
        <br />
        <em>start somewhere.</em>
      </h2>
    </div>
    <div class="contact-actions">
      <p>
        Have a question or an idea? Leave a message here and read my reply in
        the same conversation.
      </p>
      <a class="button" href="/chat/">
        Send me a message <span aria-hidden="true">↗</span>
      </a>
      <a
        class="text-link"
        href={profile.linkedin}
        target="_blank"
        rel="noopener noreferrer"
      >
        Connect on LinkedIn <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    max-width: 30rem;
  }
  .contact-actions p {
    flex-basis: 100%;
    color: var(--color-muted);
  }
  .portrait-link {
    display: block;
    border-radius: 18px;
  }
  .portrait-zoom {
    display: inline-block;
    margin: 0.9rem 0 0 1rem;
    font-size: 0.8rem;
  }
  .recent-posts {
    background: var(--color-sage);
    color: var(--color-ink);
  }
  .recent-posts-heading .eyebrow {
    color: var(--color-accent);
  }
  .recent-posts-link {
    color: var(--color-accent);
  }
  .recent-posts-link:hover {
    color: var(--color-accent-hover);
  }
  .recent-posts-link:focus-visible {
    outline-color: var(--color-accent);
  }
  .recent-posts-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .recent-post-card {
    background: var(--color-surface);
    color: var(--color-ink);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .recent-post-card h3 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 400;
    line-height: 1.3;
  }
  .recent-post-card p {
    color: var(--color-muted);
  }
  .recent-post-card > .text-link {
    margin-top: auto;
  }
  .recent-post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem 1rem;
    color: var(--color-muted);
    font-size: 0.78rem;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
  @media (max-width: 640px) {
    .recent-posts-grid {
      grid-template-columns: 1fr;
    }
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
    padding-top: 5.25rem;
    padding-bottom: 4rem;
  }
  .status-dot {
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    background: var(--color-accent, #285548);
    border-radius: 50%;
    margin-right: 0.5rem;
  }
  .hero-title {
    font-family: var(--font-display, Georgia, serif);
    font-size: clamp(3.2rem, 6.4vw, 6.25rem);
    line-height: 1.04;
    letter-spacing: -0.055em;
    margin: 1.6rem 0 1.7rem;
    font-weight: 400;
  }
  .hero-title em {
    color: var(--color-accent, #285548);
    font-weight: 400;
  }
  .hero-copy .lead {
    max-width: 34rem;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.6rem;
    align-items: center;
    margin-top: 2rem;
  }
  .hero-caption {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 0.78rem;
    color: var(--color-muted, #5c6259);
    margin-top: 3rem;
  }
  .mini-rule {
    height: 1px;
    width: 2rem;
    background: currentColor;
  }
  .hero-aside {
    max-width: 25rem;
    justify-self: end;
    width: 100%;
  }
  .portrait-mat {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 1.55rem 1.55rem 1.25rem;
    border-radius: 18px;
    position: relative;
  }
  .portrait-label {
    display: block;
    text-align: center;
    padding: 1.6rem 0 1.5rem;
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .hero-portrait {
    display: block;
    width: 100%;
    height: auto;
    margin-inline: auto;
    object-fit: contain;
    object-position: center;
    border-radius: 18px;
  }
  .portrait-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1rem;
    font-size: 0.76rem;
    line-height: 1.5;
    color: var(--color-muted);
  }
  .portrait-mark {
    font:
      italic 2.5rem Georgia,
      serif;
  }
  .hero-note {
    display: flex;
    gap: 1rem;
    align-items: center;
    margin: 1.2rem 0 0 1rem;
    color: var(--color-muted, #5c6259);
    font-size: 0.75rem;
    line-height: 1.6;
  }
  .hero-note > span:first-child {
    font-size: 2rem;
    color: var(--color-accent, #285548);
  }
  .stats-strip {
    border-top: 1px solid var(--color-border, #d7d8cd);
    border-bottom: 1px solid var(--color-border, #d7d8cd);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    padding-block: 1.8rem;
  }
  .stat {
    padding-inline: 1.6rem;
    border-left: 1px solid var(--color-border, #d7d8cd);
  }
  .stat:first-child {
    padding-left: 0;
    border-left: 0;
  }
  .stat strong {
    display: block;
    font-family: var(--font-display, Georgia, serif);
    font-size: 1.55rem;
    font-weight: 400;
  }
  .stat span {
    display: block;
    font-size: 0.76rem;
    color: var(--color-muted, #5c6259);
    margin-top: 0.4rem;
  }
  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 2rem;
  }
  .section-intro {
    max-width: 44rem;
    color: var(--color-muted, #5c6259);
    margin: 1.8rem 0 2rem;
  }
  .focus-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
  }
  .focus-card {
    border-top: 1px solid var(--color-border, #d7d8cd);
    padding-top: 1.5rem;
  }
  .focus-number {
    color: var(--color-muted, #5c6259);
    font-size: 0.72rem;
  }
  .focus-card h3 {
    margin: 1.8rem 0 0.8rem;
    font-family: var(--font-display, Georgia, serif);
    font-size: 1.6rem;
    font-weight: 400;
  }
  .focus-card p {
    color: var(--color-muted, #5c6259);
    font-size: 0.9rem;
  }
  .personal-section {
    background: var(--color-sage);
    padding-block: 5rem;
  }
  .personal-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
  }
  .personal-grid .lead {
    margin: 1.5rem 0 2rem;
  }
  .personal-list a {
    display: grid;
    grid-template-columns: 2rem 1fr auto;
    gap: 1rem;
    color: inherit;
    text-decoration: none;
    padding: 1.8rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .personal-list a:first-child {
    border-top: 1px solid var(--color-border);
  }
  .personal-list a:hover h3 {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .personal-list h3 {
    margin: 0;
    font: 400 1.45rem var(--font-display, Georgia, serif);
  }
  .personal-list p {
    font-size: 0.83rem;
    margin: 0.55rem 0 0;
    color: var(--color-muted, #5c6259);
  }
  .personal-icon {
    font-size: 1.55rem;
    color: var(--color-accent, #285548);
  }
  .journal-invitation {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
  }
  .journal-invitation p:not(.eyebrow) {
    max-width: 38rem;
    color: var(--color-muted, #5c6259);
    margin-top: 1rem;
  }
  .contact-banner {
    border-top: 1px solid var(--color-border, #d7d8cd);
    padding-block: 3.5rem 5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
  @media (max-width: 800px) {
    .hero-grid {
      grid-template-columns: 1fr;
      padding-top: 3rem;
      gap: 2.5rem;
    }
    .hero-aside {
      justify-self: center;
      max-width: 22rem;
    }
    .hero-caption {
      margin-top: 1.7rem;
    }
    .personal-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .focus-grid {
      grid-template-columns: 1fr;
      gap: 1.7rem;
    }
    .focus-card h3 {
      margin-top: 1rem;
    }
    .section-heading,
    .journal-invitation,
    .contact-banner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  @media (max-width: 480px) {
    .stats-strip {
      grid-template-columns: 1fr;
      padding-block: 0.8rem;
    }
    .stat,
    .stat:first-child {
      padding: 1rem 0;
      border-left: 0;
    }
    .stat + .stat {
      border-top: 1px solid var(--color-border, #d7d8cd);
    }
    .hero-title {
      font-size: 3.2rem;
    }
    .personal-section {
      padding-block: 3rem;
    }
  }
</style>
