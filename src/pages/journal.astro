---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  journalCategories,
  journalCategoryDefinitions,
  journalEmptyMessages,
} from '../data/journalCategories';

const categories = [{ id: 'all', label: 'All' }, ...journalCategories];
const now = Date.now();
const entries = (
  await getCollection(
    'journal',
    ({ data }) => !data.draft && data.publishedAt.getTime() <= now,
  )
).sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en-SG', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'Asia/Singapore',
  }).format(date);
const articlePath = (id: string) =>
  `/journal/${id.split('/').map(encodeURIComponent).join('/')}/`;
---

<BaseLayout
  title="Journal | Vipul Gupta"
  description="Personal writing by Vipul Gupta: thoughts and conversations, life notes, what-if possibilities, and humour."
>
  <section class="container page-header">
    <p class="eyebrow">A little room to think</p>
    <h1 class="display">Thoughts, with room to wander.</h1>
    <p class="lead journal-intro">
      A home for conversations, everyday observations, questions without tidy
      answers, and a little humour. Writing from life, wherever it leads.
    </p>
  </section>

  <section
    class="container journal-categories"
    aria-labelledby="journal-categories-heading"
  >
    <h2 id="journal-categories-heading">Four ways into the journal.</h2>
    <div class="journal-category-grid">
      {journalCategories.map((category) => (
        <div class="journal-category-card">
          <h3>
            <a
              href={`/journal/#${category.id}`}
              data-journal-category-link
              data-category={category.id}
            >
              {category.label} <span aria-hidden="true">↗</span>
            </a>
          </h3>
          <p>{category.description}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container journal-content" aria-label="Journal entries">
    <div
      class="filter-bar"
      role="group"
      aria-label="Filter journal by category"
      data-journal-filters
      hidden
    >
      {categories.map((category) => (
        <button
          id={category.id}
          class="filter-button"
          type="button"
          data-journal-filter={category.id}
          aria-pressed={category.id === 'all' ? 'true' : 'false'}
          aria-controls="journal-results"
        >
          {category.label}
        </button>
      ))}
    </div>

    <p
      class:list={[
        'eyebrow',
        'journal-status',
        { 'journal-status--empty': entries.length === 0 },
      ]}
      role="status"
      aria-live="polite"
      aria-atomic="true"
      data-journal-status
    >
      {entries.length === 0
        ? journalEmptyMessages.all
        : `${entries.length} ${entries.length === 1 ? 'entry' : 'entries'} published.`}
    </p>
    <div id="journal-results">
      {entries.length > 0 && (
        <div class="journal-grid">
          {entries.map((entry) => (
            <article
              class="card journal-card"
              data-journal-entry
              data-category={entry.data.category}
            >
              {entry.data.coverImage && (
                <a
                  href={articlePath(entry.id)}
                  tabindex="-1"
                  aria-hidden="true"
                  class="journal-cover-link"
                >
                  <img
                    class="journal-cover"
                    src={entry.data.coverImage}
                    alt=""
                    loading="lazy"
                    width="960"
                    height="640"
                  />
                </a>
              )}
              <div class="journal-card-content">
                <div class="journal-card-meta">
                  <span class="tag">
                    {journalCategoryDefinitions[entry.data.category].label}
                  </span>
                  <time datetime={entry.data.publishedAt.toISOString()}>
                    {formatDate(entry.data.publishedAt)}
                  </time>
                </div>
                <h2>
                  <a href={articlePath(entry.id)}>{entry.data.title}</a>
                </h2>
                <p>{entry.data.description}</p>
                <a class="text-link" href={articlePath(entry.id)}>
                  Read the entry <span aria-hidden="true">→</span>
                  <span class="sr-only">: {entry.data.title}</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      )}
      <div
        class="card empty-state"
        data-journal-empty
        hidden={entries.length > 0}
      >
        <img
          class="empty-state-art"
          src="/images/journal-illustration.svg"
          width="360"
          height="220"
          alt=""
        />
        <h2 class="empty-state-title">
          {entries.length === 0
            ? 'The first pages are still ahead.'
            : 'A story for another day.'}
        </h2>
        <p class="empty-state-copy">
          {entries.length === 0
            ? "This journal is just beginning. When a story is ready to share, you'll find it here."
            : 'There are no published stories in this category yet. Explore another category to keep reading.'}
        </p>
        <a class="text-link" href="/about/">
          A little about me <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <div class="journal-footnote">
      <p>For travel, photos and memories:</p>
      <a class="text-link" href="/my-space/">
        Visit My Space <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  import {
    isJournalFilter,
    journalEmptyMessages,
  } from '../data/journalCategories';

  const filters = document.querySelector<HTMLElement>('[data-journal-filters]');
  const status = document.querySelector<HTMLElement>('[data-journal-status]');
  const buttons = document.querySelectorAll<HTMLButtonElement>(
    '[data-journal-filter]',
  );
  const cards = document.querySelectorAll<HTMLElement>('[data-journal-entry]');
  const empty = document.querySelector<HTMLElement>('[data-journal-empty]');
  const categoryLinks = document.querySelectorAll<HTMLAnchorElement>(
    '[data-journal-category-link]',
  );

  if (filters && status && empty) {
    const selectCategory = (requested: string) => {
      const category = isJournalFilter(requested) ? requested : 'all';
      let count = 0;
      cards.forEach((card) => {
        card.hidden = category !== 'all' && card.dataset.category !== category;
        if (!card.hidden) count += 1;
      });
      buttons.forEach((button) => {
        button.setAttribute(
          'aria-pressed',
          String(button.dataset.journalFilter === category),
        );
      });
      empty.hidden = count > 0;
      status.textContent =
        count === 0
          ? journalEmptyMessages[category]
          : `${count} ${count === 1 ? 'entry' : 'entries'} shown.`;
    };

    selectCategory(window.location.hash.slice(1));
    filters.hidden = false;
    const revealCategory = (category: string) => {
      filters.scrollIntoView({ block: 'start' });
      Array.from(buttons)
        .find((button) => button.dataset.journalFilter === category)
        ?.focus({ preventScroll: true });
    };
    const initialCategory = window.location.hash.slice(1);
    if (isJournalFilter(initialCategory)) revealCategory(initialCategory);

    categoryLinks.forEach((link) => {
      link.addEventListener('click', (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)
          return;
        const category = link.dataset.category;
        if (!category || !isJournalFilter(category)) return;
        event.preventDefault();
        if (window.location.hash !== `#${category}`)
          window.history.pushState(null, '', `#${category}`);
        selectCategory(category);
        revealCategory(category);
      });
    });
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const category = button.dataset.journalFilter ?? 'all';
        if (window.location.hash !== `#${category}`) {
          window.history.pushState(null, '', `#${category}`);
        }
        selectCategory(category);
      });
    });
    window.addEventListener('hashchange', () => {
      const category = window.location.hash.slice(1);
      selectCategory(category);
      if (isJournalFilter(category)) revealCategory(category);
    });
  }
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .journal-content {
    padding-bottom: clamp(4rem, 9vw, 7rem);
  }

  .journal-intro {
    max-width: 46rem;
  }

  .journal-categories {
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .journal-categories h2 {
    margin-bottom: 1.5rem;
    font-size: clamp(1.6rem, 3vw, 2.1rem);
  }

  .journal-category-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .journal-category-card {
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .journal-category-card h3 {
    margin-bottom: 0.8rem;
    font-size: 1.1rem;
    line-height: 1.4;
  }

  .journal-category-card p {
    max-width: 36rem;
    color: var(--color-muted);
    line-height: 1.7;
  }

  .filter-button {
    max-width: 100%;
    white-space: normal;
    text-align: center;
    line-height: 1.4;
  }

  .journal-status {
    letter-spacing: 0.08em;
    margin-block: 1.75rem;
  }
  .journal-status--empty {
    text-align: center;
  }
  .journal-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .journal-card {
    padding: 0;
    overflow: hidden;
  }
  .journal-card-content {
    padding: 1.75rem;
  }
  .journal-card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1rem;
    font-size: 0.8rem;
    color: var(--color-muted);
  }
  .journal-card h2 {
    margin-block: 1rem 0.75rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.3;
  }
  .journal-card h2 a {
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  .journal-card p {
    margin-block: 0 1.25rem;
  }
  .journal-cover-link {
    display: block;
  }
  .journal-cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  @media (max-width: 640px) {
    .journal-grid,
    .journal-category-grid {
      grid-template-columns: 1fr;
    }
    .journal-card-content {
      padding: 1.25rem;
    }
  }

  .journal-footnote {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem 1rem;
    margin-top: 2rem;
    font-size: 0.95rem;
  }

  .journal-footnote p {
    margin: 0;
  }
</style>
